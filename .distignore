# Files and directories excluded from the distributed plugin zip.
# Used by `wp dist-archive`. Keep in sync with the build step if you zip manually.

.git
.github
.gitignore
.gitattributes
.distignore
.DS_Store

# Plugin-directory banner/icon/screenshot images, if ever added. These belong
# in the SVN root assets/ directory, never inside the plugin download.
.wordpress-org

.idea
.vscode
node_modules
package.json
package-lock.json
composer.json
composer.lock
phpcs.xml
phpcs.xml.dist
README.md
*.zip
*.log
tests
bin
